{
  "name": "leen-senas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "exe": "vite build && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.11"
  },
  "description": "Leen-Señas: aprende Lengua de Señas Colombiana",
  "author": "Equipo Leen-Señas",
  "main": "electron/main.cjs",
  "build": {
    "appId": "co.edu.ecci.leensenas",
    "productName": "Leen-Senas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Leen-Senas.exe"
    }
  }
}